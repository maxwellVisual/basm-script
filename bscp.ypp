                std::string name = std::to_string(i);
                obj->fields.emplace(name, Field(*new bscp_num(obj, raw[i]), false));
            }
            value->value = obj;
            return lex_string;
        }
        case lex_punctuation:
            value->punct = new std::string(current_token.raw, current_token.raw_size);
            return current_token.raw[0]; // Return punctuation character
